{
  "description": "Ralph Loop Fork plugin hooks - forks to new terminal on stop",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook-fork.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/spawn-bind-hook.py"
          }
        ]
      }
    ]
  }
}
